<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeekingYHWH.Scriptures.ConvertPassages.MAUI.OptionsPage"
             Title="Options">
	<ScrollView>
		<VerticalStackLayout>
			<Border>
				<VerticalStackLayout>
					<Label Text="Initial Convert Direction" FontSize="16" FontAttributes="Bold"/>
					<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
					<Grid ColumnDefinitions="*,*">
						<RadioButton Grid.Row="0" Grid.Column="0" Content="LDS -> RLDS" HorizontalOptions="Center" IsChecked="{Binding Path=DirectionLDS}"/>
						<RadioButton Grid.Row="0" Grid.Column="1" Content="RLDS -> LDS" HorizontalOptions="Center" IsChecked="{Binding Path=DirectionRLDS}"/>
					</Grid>
				</VerticalStackLayout>
			</Border>
			<Border>
				<VerticalStackLayout>
					<Label Text="Convert then Copy" FontSize="16" FontAttributes="Bold"/>
					<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
					<Grid ColumnDefinitions="*,*,*">
						<RadioButton Grid.Column="0" Content="Never" HorizontalOptions="Center" IsChecked="{Binding Path=ConvertNever}"/>
						<RadioButton Grid.Column="1" Content="Always" HorizontalOptions="Center" IsChecked="{Binding Path=ConvertAlways}"/>
						<RadioButton Grid.Column="2" Content="No Error" HorizontalOptions="Center" IsChecked="{Binding Path=ConvertSuccess}"/>
					</Grid>
				</VerticalStackLayout>
			</Border>
			<Border>
				<VerticalStackLayout>
					<Label Text="LDS -> RLDS" FontSize="18" FontAttributes="Bold"/>
					<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
					<Border>
						<VerticalStackLayout>
							<Label Text="Book of Mormon" FontSize="16" FontAttributes="Bold"/>
							<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
							<Grid ColumnDefinitions="*,*,*" HorizontalOptions="Fill">
								<RadioButton Grid.Column="0" Content="LDS RLDS" HorizontalOptions="Center" IsChecked="{Binding Path=LDSBoMS}" CheckedChanged="OnLDSBoMS"/>
								<RadioButton Grid.Column="1" Content="RLDS LDS" HorizontalOptions="Center" IsChecked="{Binding Path=LDSBoMO}" CheckedChanged="OnLDSBoMO"/>
								<RadioButton Grid.Column="2" Content="RLDS" HorizontalOptions="Center" IsChecked="{Binding Path=LDSBoMN}" CheckedChanged="OnLDSBoMN"/>
							</Grid>
							<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" HorizontalOptions="Fill" x:Name="ldsBoMGrid">
								<Label Grid.Row="0" Grid.Column="0" Text="Pre:" HorizontalOptions="End"/>
								<Editor Grid.Row="0" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSBoMPre}" x:Name="ldsBoMPre"/>
								<Label Grid.Row="1" Grid.Column="0" Text="Center:" HorizontalOptions="End" x:Name="ldsBoMCenterLabel"/>
								<Editor Grid.Row="1" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSBoMCenter}" x:Name="ldsBoMCenter"/>
								<Label Grid.Row="2" Grid.Column="0" Text="Post:" HorizontalOptions="End"/>
								<Editor Grid.Row="2" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSBoMPost}" x:Name="ldsBoMPost"/>
							</Grid>
						</VerticalStackLayout>
					</Border>
					<Border>
						<VerticalStackLayout>
							<Label Text="Doctrine and Covenants" FontSize="16" FontAttributes="Bold"/>
							<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
							<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
								<Label Grid.Row="0" Grid.Column="0" Text="LDS Pre:" HorizontalOptions="End"/>
								<Editor Grid.Row="0" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSDnCSourcePre}"/>
								<Label Grid.Row="1" Grid.Column="0" Text="LDS Post:" HorizontalOptions="End"/>
								<Editor Grid.Row="1" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSDnCSourcePost}"/>
								<Label Grid.Row="2" Grid.Column="0" Text="Others Pre:" HorizontalOptions="End"/>
								<Editor Grid.Row="2" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSDnCOthersPre}"/>
								<Label Grid.Row="3" Grid.Column="0" Text="Others Post:" HorizontalOptions="End"/>
								<Editor Grid.Row="3" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=LDSDnCOthersPost}"/>
								<CheckBox Grid.Row="4" Grid.Column="0" HorizontalOptions="End" IsChecked="{Binding Path=LDSDnC1833}"/>
								<Label Grid.Row="4" Grid.Column="1" Text="Include 1833" HorizontalOptions="Start"/>
								<CheckBox Grid.Row="5" Grid.Column="0" HorizontalOptions="End" IsChecked="{Binding Path=LDSDnC1835}"/>
								<Label Grid.Row="5" Grid.Column="1" Text="Include 1835" HorizontalOptions="Start"/>
								<CheckBox Grid.Row="6" Grid.Column="0" HorizontalOptions="End" IsChecked="{Binding Path=LDSDnC1844}"/>
								<Label Grid.Row="6" Grid.Column="1" Text="Include 1844" HorizontalOptions="Start"/>
							</Grid>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>
			</Border>
			<Border>
				<VerticalStackLayout>
					<Label Text="RLDS -> LDS" FontSize="18" FontAttributes="Bold"/>
					<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
					<Border>
						<VerticalStackLayout>
							<Label Text="Book of Mormon" FontSize="16" FontAttributes="Bold"/>
							<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
							<Grid ColumnDefinitions="*,*,*" HorizontalOptions="Fill">
								<RadioButton Grid.Column="0" Content="RLDS LDS" HorizontalOptions="Center" IsChecked="{Binding Path=RLDSBoMS}" CheckedChanged="OnRLDSBoMS"/>
								<RadioButton Grid.Column="1" Content="LDS RLDS" HorizontalOptions="Center" IsChecked="{Binding Path=RLDSBoMO}" CheckedChanged="OnRLDSBoMO"/>
								<RadioButton Grid.Column="2" Content="LDS" HorizontalOptions="Center" IsChecked="{Binding Path=RLDSBoMN}" CheckedChanged="OnRLDSBoMN"/>
							</Grid>
							<Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" HorizontalOptions="Fill" x:Name="rldsBoMGrid">
								<Label Grid.Row="0" Grid.Column="0" Text="Pre:" HorizontalOptions="End"/>
								<Editor Grid.Row="0" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSBoMPre}" x:Name="rldsBoMPre"/>
								<Label Grid.Row="1" Grid.Column="0" Text="Center:" HorizontalOptions="End" x:Name="rldsBoMCenterLabel"/>
								<Editor Grid.Row="1" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSBoMCenter}" x:Name="rldsBoMCenter"/>
								<Label Grid.Row="2" Grid.Column="0" Text="Post:" HorizontalOptions="End"/>
								<Editor Grid.Row="2" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSBoMPost}" x:Name="rldsBoMPost"/>
							</Grid>
						</VerticalStackLayout>
					</Border>
					<Border>
						<VerticalStackLayout>
							<Label Text="Doctrine and Covenants" FontSize="16" FontAttributes="Bold"/>
							<BoxView HeightRequest="1" HorizontalOptions="Fill"/>
							<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
								<Label Grid.Row="0" Grid.Column="0" Text="RLDS Pre:" HorizontalOptions="End"/>
								<Editor Grid.Row="0" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSDnCSourcePre}"/>
								<Label Grid.Row="1" Grid.Column="0" Text="RLDS Post:" HorizontalOptions="End"/>
								<Editor Grid.Row="1" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSDnCSourcePost}"/>
								<Label Grid.Row="2" Grid.Column="0" Text="Others Pre:" HorizontalOptions="End"/>
								<Editor Grid.Row="2" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSDnCOthersPre}"/>
								<Label Grid.Row="3" Grid.Column="0" Text="Others Post:" HorizontalOptions="End"/>
								<Editor Grid.Row="3" Grid.Column="1" HorizontalOptions="Fill" Text="{Binding Path=RLDSDnCOthersPost}"/>
								<CheckBox Grid.Row="4" Grid.Column="0" HorizontalOptions="End" IsChecked="{Binding Path=RLDSDnC1833}"/>
								<Label Grid.Row="4" Grid.Column="1" Text="Include 1833" HorizontalOptions="Start"/>
								<CheckBox Grid.Row="5" Grid.Column="0" HorizontalOptions="End" IsChecked="{Binding Path=RLDSDnC1835}"/>
								<Label Grid.Row="5" Grid.Column="1" Text="Include 1835" HorizontalOptions="Start"/>
								<CheckBox Grid.Row="6" Grid.Column="0" HorizontalOptions="End" IsChecked="{Binding Path=RLDSDnC1844}"/>
								<Label Grid.Row="6" Grid.Column="1" Text="Include 1844" HorizontalOptions="Start"/>
							</Grid>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>