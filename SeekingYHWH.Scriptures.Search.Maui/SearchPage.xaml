<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeekingYHWH.Scriptures.SearchPage">
    <Grid
        RowDefinitions="Auto,Auto,*">
        <Editor Placeholder="Query" AutoSize="TextChanges" Completed="Search" Grid.Row="0" x:Name="queryEditor"/>
        <Grid ColumnDefinitions="*,*,*,*" Grid.Row="1">
            <Button Text="Copy All" Clicked="CopyAll" Grid.Column="0"/>
            <Button Text="Copy Selected" Clicked="CopySelected" Grid.Column="1"/>
            <Button Text="Clear Selected" Clicked="ClearSelected" Grid.Column="2"/>
            <Button Text="Search" Clicked="Search" Grid.Column="3"/>
        </Grid>
        <CollectionView ItemSizingStrategy="MeasureAllItems" SelectionMode="Multiple" Grid.Row="2" x:Name="found">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
