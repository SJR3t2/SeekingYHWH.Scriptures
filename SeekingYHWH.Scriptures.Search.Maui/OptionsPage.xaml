<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SeekingYHWH.Scriptures.OptionsPage">
    <Grid
        RowDefinitions="Auto,Auto,*">
        <Picker Title="Language" SelectedIndexChanged="LanguagesChanged" Grid.Row="0" x:Name="languagesPicker"/>
        <AbsoluteLayout Grid.Row="1">
            <RadioButton Content="Sentence" CheckedChanged="PortionSentenceChanged" AbsoluteLayout.LayoutBounds="0,0.5" AbsoluteLayout.LayoutFlags="PositionProportional" x:Name="portionSentence"/>
            <RadioButton Content="Verse" CheckedChanged="PortionVerseChanged" AbsoluteLayout.LayoutBounds="0.5,0.5" AbsoluteLayout.LayoutFlags="PositionProportional" x:Name="portionVerse"/>
            <RadioButton Content="Chapter" CheckedChanged="PortionChapterChanged" AbsoluteLayout.LayoutBounds="1,0.5" AbsoluteLayout.LayoutFlags="PositionProportional" x:Name="portionChapter"/>
        </AbsoluteLayout>
        <ListView SelectionMode="None" Grid.Row="2" x:Name="booksList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <AbsoluteLayout>
                            <Label Text="{Binding Name}" FontSize="14" AbsoluteLayout.LayoutBounds="0,0.5" AbsoluteLayout.LayoutFlags="PositionProportional"/>
                            <HorizontalStackLayout AbsoluteLayout.LayoutBounds="1,0.5" AbsoluteLayout.LayoutFlags="PositionProportional">
                                <Label Text="Include:" VerticalOptions="Center"/>
                                <CheckBox IsChecked="{Binding Include, Mode=TwoWay}"/>
                                <Label Text="Pre:" IsEnabled="{Binding PrePossible}" VerticalOptions="Center"/>
                                <CheckBox IsEnabled="{Binding PrePossible}" IsChecked="{Binding PreUse, Mode=TwoWay}"/>
                            </HorizontalStackLayout>
                        </AbsoluteLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>