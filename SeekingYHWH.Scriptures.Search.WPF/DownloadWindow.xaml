<Window x:Class="SeekingYHWH.Scriptures.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SeekingYHWH.Scriptures"
        mc:Ignorable="d"
        Title="Download"
        ShowInTaskbar="False"
        Height="550" Width="400">
    <DockPanel LastChildFill="True">
        <ComboBox DockPanel.Dock="Top" x:Name="languagesCombo" SelectionChanged="OnLanguagesChanged"/>
        <Grid DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Content="Remove Books List" x:Name="booksRemove"/>
            <Button Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Content="Refresh Books List" x:Name="booksRefresh"/>
            <Button Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" Content="Refresh Languages" Click="OnLanguagesDownload"/>
        </Grid>
        <DataGrid AutoGenerateColumns="False" x:Name="booksList">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name, Mode=OneWay}"/>
                <DataGridTemplateColumn Header="Download">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Download, Mode=OneWay}" Click="OnDownloadBook"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Remove">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" IsEnabled="{Binding Downloaded, Mode=OneWay}" Click="OnRemoveBook"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
